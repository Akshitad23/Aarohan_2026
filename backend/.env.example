# Copy to backend/.env for local development. Never commit the filled file.
ADMIN_PASSWORD=
GROQ_API_KEY=
# Neon pooled Postgres URL, including its SSL parameters. Keep this private.
DATABASE_URL=
# Hosted deployments require Postgres; local development can keep this false.
REQUIRE_DATABASE_URL=false
DB_POOL_MAX=4
# Optional absolute path. Default: backend/data/event.sqlite3
DATABASE_PATH=
PORT=5000
WEB_CONCURRENCY=1
WEB_THREADS=8
GROQ_MODEL_PERSONA=openai/gpt-oss-120b
GROQ_API_TIMEOUT=10
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_MAX_CONCURRENT=4
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=8000
GROQ_RPD_LIMIT=1000
GROQ_TPD_LIMIT=200000
GROQ_TEAM_MIN_INTERVAL=60
GROQ_CONTEXT_BYTES=2800
# Optional backup only. Groq remains the first provider.
# Render needs an authenticated HTTPS gateway, not a laptop's localhost URL.
OLLAMA_BACKUP_URL=
OLLAMA_BACKUP_MODEL=
OLLAMA_BACKUP_TOKEN=
OLLAMA_BACKUP_TIMEOUT=10
ROUND2_SECONDS=900
# Optional absolute path to a private validated cipher catalog.
CIPHER_CATALOG_PATH=
