# Copy to backend/.env for an isolated local rehearsal. Do not use production Neon here.
ADMIN_PASSWORD=choose-a-local-rehearsal-password
GROQ_API_KEY=
DATABASE_URL=
REQUIRE_DATABASE_URL=false
DATABASE_PATH=data/rehearsal.sqlite3
DB_POOL_MAX=4
PORT=5000
WEB_THREADS=8
GROQ_MODEL_PERSONA=openai/gpt-oss-120b
GROQ_API_TIMEOUT=10
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_MAX_CONCURRENT=4
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=8000
GROQ_RPD_LIMIT=1000
GROQ_TPD_LIMIT=200000
GROQ_TEAM_MIN_INTERVAL=60
GROQ_CONTEXT_BYTES=2800
# Local Ollama can answer rehearsal prompts without using Groq quota.
OLLAMA_BACKUP_URL=http://127.0.0.1:11434
OLLAMA_BACKUP_MODEL=gemma3:4b
OLLAMA_BACKUP_TIMEOUT=25
CIPHER_CATALOG_PATH=
